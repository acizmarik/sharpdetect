<Project>
    <!-- Basic metadata -->
    <PropertyGroup>
        <Authors>Andrej Čižmárik</Authors>
        <Copyright>Copyright © Andrej Čižmárik</Copyright>
        <Description>Dynamic analysis framework for .NET. Runs an application or a test suite with a CoreCLR profiler attached and reports observed concurrency issues during the run.</Description>
        <PackageTags>data-race;race-detector;deadlock;concurrency;threading;thread-safety;multithreading;testing;dotnet-tool;profiler;dynamic-analysis</PackageTags>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch Condition="'$(GITHUB_REF_NAME)' != ''">$(GITHUB_REF_NAME)</RepositoryBranch>
        <RepositoryCommit Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
        <RepositoryUrl>https://github.com/acizmarik/sharpdetect</RepositoryUrl>
        <PackageProjectUrl>https://github.com/acizmarik/sharpdetect</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/acizmarik/sharpdetect/releases</PackageReleaseNotes>
    </PropertyGroup>
    
    <!-- Licensing -->
    <PropertyGroup>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    </PropertyGroup>
  
    <!-- Compilation -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_RUN_ID)' != ''">true</ContinuousIntegrationBuild>
        <DebugType>embedded</DebugType>
        <Features>strict</Features>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
        
    <!-- Versioning -->
    <PropertyGroup>
        <Version>2.2.0-prerelease-09</Version>
    </PropertyGroup>

    <!-- Static analysis -->
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
    </PropertyGroup>

    <!-- NuGet audit -->
    <PropertyGroup Condition="'$(StrictNuGetAudit)' == 'true'">
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>
    <PropertyGroup Condition="'$(StrictNuGetAudit)' != 'true'">
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    </PropertyGroup>
</Project>